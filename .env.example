# Copy to .env and adjust. Every setting except ADMIN_TOKEN has a default in app/config.py.

# Required, at least 32 characters. The gateway refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOUNCER_ADMIN_TOKEN=

# Used when running the gateway natively. Docker Compose overrides these with container addresses.
BOUNCER_DATABASE_URL=postgresql+asyncpg://bouncer:bouncer@localhost:5432/bouncer
BOUNCER_REDIS_URL=redis://localhost:6379/0

# Upstream name -> base URL, as JSON. models.yaml says which model uses which upstream.
BOUNCER_UPSTREAMS={"ollama": "http://localhost:11434", "mock": "http://localhost:8001"}

# Seconds. Non-streaming responses send nothing until generation finishes,
# so the read timeout must cover the whole generation on a CPU model.
BOUNCER_UPSTREAM_CONNECT_TIMEOUT=5
BOUNCER_UPSTREAM_READ_TIMEOUT=300

# Gateway-wide cap on completion tokens per request (see DESIGN.md §2).
BOUNCER_MAX_TOKENS_CAP=2048
