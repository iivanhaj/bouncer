# Copy to .env and adjust. Every setting here has a default in app/config.py.

# Where the model server lives.
# Running the gateway natively on Windows:  http://localhost:11434
# Running the gateway inside Docker:        http://host.docker.internal:11434
BOUNCER_UPSTREAM_BASE_URL=http://localhost:11434

# Seconds. Non-streaming responses send nothing until generation finishes,
# so the read timeout must cover the whole generation on a CPU model.
BOUNCER_UPSTREAM_CONNECT_TIMEOUT=5
BOUNCER_UPSTREAM_READ_TIMEOUT=300

# Gateway-wide cap on completion tokens per request (see DESIGN.md §2).
BOUNCER_MAX_TOKENS_CAP=2048
